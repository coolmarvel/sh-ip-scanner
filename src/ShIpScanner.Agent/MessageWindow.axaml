<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShIpScanner.Agent.MessageWindow"
        Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Topmost="True"
        Icon="/Assets/agenticon.ico"
        Title="관리자 안내">

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="관리자 안내 메시지" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" x:Name="MessageText" FontSize="14" TextWrapping="Wrap" />
        <Button Grid.Row="2" Content="확인" Click="OnClose" HorizontalAlignment="Right" Padding="24,7" />
    </Grid>
</Window>
