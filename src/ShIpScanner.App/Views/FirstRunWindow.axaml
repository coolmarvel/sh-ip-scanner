<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShIpScanner.App.ViewModels"
        x:Class="ShIpScanner.App.Views.FirstRunWindow"
        x:DataType="vm:MainViewModel"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/appicon.ico"
        Title="처음 실행 안내">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="스캔할 대역을 등록해 주세요" FontSize="16" FontWeight="SemiBold" />

        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#445"
                   Text="저장된 스캔 대역이 없습니다. 현재 PC 의 네트워크 대역을 자동으로 감지해 목록에 추가하며, [대역 관리]에서 스캔할 대역을 자유롭게 추가·삭제할 수 있습니다. 등록한 목록은 이 PC 에 저장되어 다음 실행부터는 이 안내가 나타나지 않습니다." />

        <!-- 자동 감지된 내 IP 안내(감지 실패 시 빈 문자열이라 표시할 내용이 없음) -->
        <TextBlock FontSize="13" Foreground="#2A6"
                   IsVisible="{Binding LocalIpText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding LocalIpText, StringFormat='감지된 내 IP: {0}'}" />
        <TextBlock FontSize="13" Foreground="#C60" TextWrapping="Wrap"
                   IsVisible="{Binding LocalIpText, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                   Text="네트워크 대역을 자동 감지하지 못했습니다. [대역 관리]에서 직접 등록해 주세요." />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="대역 관리 열기" Click="OnOpenManager" Padding="14,6" />
            <Button Content="나중에" Click="OnLater" Padding="14,6" />
        </StackPanel>
    </StackPanel>
</Window>
