<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShIpScanner.App.ViewModels"
        xmlns:cfg="using:ShIpScanner.Core.Config"
        x:Class="ShIpScanner.App.Views.SubnetManagerWindow"
        x:DataType="vm:MainViewModel"
        Width="440" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/appicon.ico"
        Title="대역 관리">

    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" Text="스캔할 대역을 추가·삭제합니다. (앞 3옥텟만 입력, 예: 192.168.10)"
                   FontSize="13" Foreground="#445" Margin="0,0,0,10" TextWrapping="Wrap" />

        <!-- 대역 목록 -->
        <Border Grid.Row="1" BorderBrush="#C4CCD6" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Subnets}" SelectedItem="{Binding SelectedSubnet, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="cfg:SubnetDefinition">
                        <TextBlock Text="{Binding Display}" FontSize="14" Padding="2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 추가 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBox Text="{Binding NewSubnet, Mode=TwoWay}" Watermark="예: 192.168.10"
                     Width="200" VerticalContentAlignment="Center" />
            <Button Content="＋ 추가" Command="{Binding AddSubnetCommand}" Padding="12,6" />
            <Button Content="선택 삭제" Command="{Binding RemoveSubnetCommand}" Padding="12,6" />
        </StackPanel>

        <!-- 닫기 -->
        <Button Grid.Row="3" Content="닫기" Click="OnClose" HorizontalAlignment="Right"
                Margin="0,14,0,0" Padding="20,6" />
    </Grid>
</Window>
