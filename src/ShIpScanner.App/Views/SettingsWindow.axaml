<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShIpScanner.App.ViewModels"
        x:Class="ShIpScanner.App.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Width="440" Height="470"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/appicon.ico"
        Title="설정">

    <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="스캔 옵션" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

        <Grid Grid.Row="1" ColumnDefinitions="*,140" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="핑 타임아웃 (ms)" VerticalAlignment="Center" FontSize="13" />
            <NumericUpDown Grid.Column="1" Value="{Binding TimeoutMs}" Minimum="100" Maximum="10000" Increment="100" FormatString="0" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,140" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="동시 스캔 개수" VerticalAlignment="Center" FontSize="13" />
            <NumericUpDown Grid.Column="1" Value="{Binding MaxParallel}" Minimum="1" Maximum="512" Increment="16" FormatString="0" />
        </Grid>

        <CheckBox Grid.Row="3" IsChecked="{Binding ResolveNames}" Content="PC명(호스트명) 조회 — NetBIOS/역DNS" FontSize="13" />

        <TextBlock Grid.Row="4" Text="에이전트(원격 제어) 옵션" FontSize="15" FontWeight="Bold" Margin="0,14,0,10" />

        <CheckBox Grid.Row="5" IsChecked="{Binding DetectAgents}" Content="스캔 시 에이전트 설치 여부 조회" FontSize="13" Margin="0,0,0,8" />

        <Grid Grid.Row="6" ColumnDefinitions="*,180" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="공유 인증 토큰 (에이전트와 동일해야 함)" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
            <TextBox Grid.Column="1" Text="{Binding AgentToken}" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="7" ColumnDefinitions="*,140">
            <TextBlock Grid.Column="0" Text="에이전트 포트" VerticalAlignment="Center" FontSize="13" />
            <NumericUpDown Grid.Column="1" Value="{Binding AgentPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
        </Grid>

        <TextBlock Grid.Row="8" VerticalAlignment="Bottom" FontSize="12" Foreground="#667" TextWrapping="Wrap"
                   Text="설정은 다음 검색부터 적용됩니다. 토큰은 각 PC 의 에이전트와 같아야 명령이 동작합니다. 바둑판에서 살아있는 PC 를 더블클릭하면 제어 창이 열립니다." />

        <StackPanel Grid.Row="9" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="저장" Command="{Binding SaveSettingsCommand}" Click="OnSaveClose"
                    Background="#2E9E5B" Foreground="White" Padding="20,6" FontWeight="Bold" />
            <Button Content="취소" Click="OnClose" Padding="20,6" />
        </StackPanel>
    </Grid>
</Window>
