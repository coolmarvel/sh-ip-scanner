<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShIpScanner.App.ViewModels"
        xmlns:conv="using:ShIpScanner.App.Converters"
        xmlns:cfg="using:ShIpScanner.Core.Config"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="760"
        x:Class="ShIpScanner.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/appicon.ico"
        Width="940" Height="760" MinWidth="760" MinHeight="580"
        CanResize="True"
        FontSize="13"
        Title="sh Manager">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:HostStateToBrushConverter x:Key="StateToBrush" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="#EEF2F7">

        <!-- ① 헤더: [아이콘 메뉴] 제목  ────  라이센스 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Background="#D7E2F0" Height="52">
            <!-- 좌상단 아이콘을 누르면 옵션 메뉴(대역 관리·설정·정보)가 뜬다 (옛 실행기 느낌) -->
            <Button Grid.Column="0" Margin="10,0,0,0" Padding="4" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="메뉴">
                <Image Source="/Assets/appicon.ico" Width="30" Height="30" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="대역 관리…" Click="OnManageSubnets" />
                        <MenuItem Header="설정…" Click="OnSettings" />
                        <Separator />
                        <MenuItem Header="정보" Click="OnAbout" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <TextBlock Grid.Column="1" Text="sh Manager" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="8,0,0,0" />

            <TextBlock Grid.Column="2" Text="© 2026 이성현 (SeongHyun Lee)" Margin="0,0,14,0"
                       VerticalAlignment="Center" FontSize="12" Foreground="#455" />
        </Grid>

        <!-- ② 컨트롤: 설명·내 IP  ────  대역 선택·검색 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="14,12">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="스캔할 대역을 고르고 [검색 시작]을 누르세요. 사용 중인 IP·PC명을 조회합니다."
                           FontSize="14" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="내 IP" FontSize="13" Foreground="#556" VerticalAlignment="Center" />
                    <Border Background="#E2EAF4" CornerRadius="4" Padding="9,3">
                        <TextBlock Text="{Binding LocalIpText}" FontSize="14" FontWeight="SemiBold" Foreground="#16283A" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="대역" VerticalAlignment="Center" FontSize="14" />
                <ComboBox ItemsSource="{Binding Subnets}" SelectedItem="{Binding SelectedSubnet, Mode=TwoWay}"
                          MinWidth="200" FontSize="14" IsEnabled="{Binding !IsScanning}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="cfg:SubnetDefinition">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="검색 시작" Command="{Binding StartScanCommand}"
                        IsEnabled="{Binding !IsScanning}" Background="#2E9E5B" Foreground="White"
                        Padding="16,7" FontWeight="Bold" />
                <Button Content="중지" Command="{Binding StopScanCommand}"
                        IsEnabled="{Binding IsScanning}" Padding="12,7" />
            </StackPanel>
        </Grid>

        <!-- ③ 로그 영역 -->
        <Border Grid.Row="2" Background="#101010" Height="96" Margin="14,0" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Log}" Margin="10,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#7CFC7C" FontFamily="Consolas,monospace" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ④ 바둑판 — 폭에 맞춰 15열 신축 -->
        <ScrollViewer Grid.Row="3" Margin="14,12,14,14"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="15" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HostCellViewModel">
                        <Border Height="44" Margin="1" HorizontalAlignment="Stretch"
                                BorderBrush="#B0B0B0" BorderThickness="1"
                                Background="{Binding State, Converter={StaticResource StateToBrush}}"
                                DoubleTapped="OnCellDoubleTapped"
                                ToolTip.Tip="{Binding Ip}">
                            <Grid Margin="3,1">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0" Text="{Binding Octet}" FontSize="11" FontWeight="Bold" Foreground="#222" />
                                    <TextBlock Grid.Row="1" Text="{Binding HostName}" FontSize="10" Foreground="#222"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <!-- 에이전트 설치 배지(우상단 파란 점) -->
                                <Ellipse Width="9" Height="9" Fill="#1E6FE0" Stroke="White" StrokeThickness="1"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         IsVisible="{Binding AgentInstalled}" ToolTip.Tip="sh Agent 설치됨" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
